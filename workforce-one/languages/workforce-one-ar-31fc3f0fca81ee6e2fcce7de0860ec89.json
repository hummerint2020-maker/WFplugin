{"translation-revision-date":"2026-09-30T22:24:16+00:00","generator":"WP-CLI\/2.12.0","source":"assets\/js\/time.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"ar","plural-forms":"nplurals=6; plural=(n==0 ? 0 : n==1 ? 1 : n==2 ? 2 : n%100>=3 && n%100<=10 ? 3 : n%100>=11 ? 4 : 5);"},"Starting camera\u2026":["\u062c\u0627\u0631\u064d \u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u0643\u0627\u0645\u064a\u0631\u0627\u2026"],"Please allow location access when your browser asks. Your location is required to record Sign In \/ Sign Out.":["\u0627\u0633\u0645\u062d \u0628\u0627\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u0649 \u0645\u0648\u0642\u0639\u0643 \u0639\u0646\u062f\u0645\u0627 \u064a\u0637\u0644\u0628 \u0627\u0644\u0645\u062a\u0635\u0641\u062d \u0630\u0644\u0643. \u0645\u0648\u0642\u0639\u0643 \u0645\u0637\u0644\u0648\u0628 \u0644\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u062d\u0636\u0648\u0631 \u0648\u0627\u0644\u0627\u0646\u0635\u0631\u0627\u0641."],"Location access requires HTTPS. Please open Workforce One using a secure connection.":["\u0627\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u0649 \u0627\u0644\u0645\u0648\u0642\u0639 \u064a\u062a\u0637\u0644\u0628 HTTPS. \u0627\u0641\u062a\u062d Workforce One \u0639\u0628\u0631 \u0627\u062a\u0635\u0627\u0644 \u0622\u0645\u0646."],"Location Services are not supported by this browser. Please use a modern browser.":["\u0647\u0630\u0627 \u0627\u0644\u0645\u062a\u0635\u0641\u062d \u0644\u0627 \u064a\u062f\u0639\u0645 \u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0645\u0648\u0642\u0639. \u0627\u0633\u062a\u062e\u062f\u0645 \u0645\u062a\u0635\u0641\u062d\u064b\u0627 \u062d\u062f\u064a\u062b\u064b\u0627."],"Location permission was denied. Please allow Location Services for this site, then try again.":["\u062a\u0645 \u0631\u0641\u0636 \u0625\u0630\u0646 \u0627\u0644\u0645\u0648\u0642\u0639. \u0627\u0633\u0645\u062d \u0628\u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0645\u0648\u0642\u0639 \u0644\u0647\u0630\u0627 \u0627\u0644\u0645\u0648\u0642\u0639 \u062b\u0645 \u062d\u0627\u0648\u0644 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649."],"Your location could not be determined. Turn on Location Services\/GPS and try again.":["\u062a\u0639\u0630\u0651\u0631 \u062a\u062d\u062f\u064a\u062f \u0645\u0648\u0642\u0639\u0643. \u0634\u063a\u0651\u0644 \u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0645\u0648\u0642\u0639 \/ GPS \u062b\u0645 \u062d\u0627\u0648\u0644 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649."],"Location request timed out. Turn on Location Services\/GPS and try again.":["\u0627\u0646\u062a\u0647\u062a \u0645\u0647\u0644\u0629 \u062a\u062d\u062f\u064a\u062f \u0627\u0644\u0645\u0648\u0642\u0639. \u0634\u063a\u0651\u0644 \u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0645\u0648\u0642\u0639 \/ GPS \u062b\u0645 \u062d\u0627\u0648\u0644 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649."],"We need your location to continue. Please allow Location Services for this site.":["\u0646\u062d\u062a\u0627\u062c \u0625\u0644\u0649 \u0645\u0648\u0642\u0639\u0643 \u0644\u0644\u0645\u062a\u0627\u0628\u0639\u0629. \u0627\u0633\u0645\u062d \u0628\u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0645\u0648\u0642\u0639 \u0644\u0647\u0630\u0627 \u0627\u0644\u0645\u0648\u0642\u0639."],"QR detected. Waiting for your location\u2026":["\u062a\u0645 \u0627\u0644\u062a\u0639\u0631\u0641 \u0639\u0644\u0649 \u0627\u0644\u0631\u0645\u0632. \u0641\u064a \u0627\u0646\u062a\u0638\u0627\u0631 \u062a\u062d\u062f\u064a\u062f \u0645\u0648\u0642\u0639\u0643\u2026"],"QR detected. Review and tap Sign In with QR.":["\u062a\u0645 \u0627\u0644\u062a\u0639\u0631\u0641 \u0639\u0644\u0649 \u0627\u0644\u0631\u0645\u0632. \u0631\u0627\u062c\u0639 \u062b\u0645 \u0627\u0636\u063a\u0637 \u00ab\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u062d\u0636\u0648\u0631 \u0639\u0628\u0631 QR\u00bb."],"Location Services are required for QR Sign In.":["\u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0645\u0648\u0642\u0639 \u0645\u0637\u0644\u0648\u0628\u0629 \u0644\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u062d\u0636\u0648\u0631 \u0639\u0628\u0631 QR."],"Location permission is required for QR Sign In. Please allow Location Services and try again.":["\u0625\u0630\u0646 \u0627\u0644\u0645\u0648\u0642\u0639 \u0645\u0637\u0644\u0648\u0628 \u0644\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u062d\u0636\u0648\u0631 \u0639\u0628\u0631 QR. \u0627\u0633\u0645\u062d \u0628\u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0645\u0648\u0642\u0639 \u062b\u0645 \u062d\u0627\u0648\u0644 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649."],"Camera QR scanning is unavailable on this browser\/device.":["\u0627\u0644\u0645\u0633\u062d \u0628\u0627\u0644\u0643\u0627\u0645\u064a\u0631\u0627 \u063a\u064a\u0631 \u0645\u062a\u0627\u062d \u0639\u0644\u0649 \u0647\u0630\u0627 \u0627\u0644\u0645\u062a\u0635\u0641\u062d \u0623\u0648 \u0627\u0644\u062c\u0647\u0627\u0632."],"Point the camera at the workplace QR.":["\u0648\u062c\u0651\u0647 \u0627\u0644\u0643\u0627\u0645\u064a\u0631\u0627 \u0625\u0644\u0649 \u0631\u0645\u0632 QR \u0627\u0644\u062e\u0627\u0635 \u0628\u0645\u0643\u0627\u0646 \u0627\u0644\u0639\u0645\u0644."],"Camera permission was denied or unavailable.":["\u062a\u0645 \u0631\u0641\u0636 \u0625\u0630\u0646 \u0627\u0644\u0643\u0627\u0645\u064a\u0631\u0627 \u0623\u0648 \u0623\u0646\u0647\u0627 \u063a\u064a\u0631 \u0645\u062a\u0627\u062d\u0629."]}}}