{"translation-revision-date":"2026-09-30T22:24:16+00:00","generator":"WP-CLI\/2.12.0","source":"assets\/js\/workforce-one.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"ar","plural-forms":"nplurals=6; plural=(n==0 ? 0 : n==1 ? 1 : n==2 ? 2 : n%100>=3 && n%100<=10 ? 3 : n%100>=11 ? 4 : 5);"},"Not enrolled":["\u063a\u064a\u0631 \u0645\u0633\u062c\u0651\u0644"],"Verify Face":["\u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u0644\u0648\u062c\u0647"],"Set Up \/ Verify Face":["\u062a\u0633\u062c\u064a\u0644 \/ \u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u0644\u0648\u062c\u0647"],"Loading face model\u2026":["\u062c\u0627\u0631\u064d \u062a\u062d\u0645\u064a\u0644 \u0646\u0645\u0648\u0630\u062c \u0627\u0644\u0648\u062c\u0647\u2026"],"Enrolled (%d samples)":["\u0645\u0633\u062c\u0651\u0644 (%d \u0639\u064a\u0646\u0627\u062a)"],"Could not load face-api.js.":["\u062a\u0639\u0630\u0651\u0631 \u062a\u062d\u0645\u064a\u0644 \u0645\u0643\u062a\u0628\u0629 \u0627\u0644\u062a\u0639\u0631\u0641 \u0639\u0644\u0649 \u0627\u0644\u0648\u062c\u0647."],"Camera is not supported by this browser.":["\u0647\u0630\u0627 \u0627\u0644\u0645\u062a\u0635\u0641\u062d \u0644\u0627 \u064a\u062f\u0639\u0645 \u0627\u0644\u0643\u0627\u0645\u064a\u0631\u0627."],"No face detected. Center your face and try again.":["\u0644\u0645 \u064a\u062a\u0645 \u0627\u0643\u062a\u0634\u0627\u0641 \u0648\u062c\u0647. \u0636\u0639 \u0648\u062c\u0647\u0643 \u0641\u064a \u0627\u0644\u0645\u0646\u062a\u0635\u0641 \u0648\u062d\u0627\u0648\u0644 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649."],"More than one face detected. Only one person may be in the camera.":["\u062a\u0645 \u0627\u0643\u062a\u0634\u0627\u0641 \u0623\u0643\u062b\u0631 \u0645\u0646 \u0648\u062c\u0647. \u064a\u062c\u0628 \u0623\u0646 \u064a\u0638\u0647\u0631 \u0634\u062e\u0635 \u0648\u0627\u062d\u062f \u0641\u0642\u0637 \u0623\u0645\u0627\u0645 \u0627\u0644\u0643\u0627\u0645\u064a\u0631\u0627."],"Liveness calibration: keep your eyes open and look at the camera\u2026":["\u0645\u0639\u0627\u064a\u0631\u0629 \u0627\u0644\u062a\u062d\u0642\u0642 \u0627\u0644\u062d\u064a: \u0623\u0628\u0642\u0650 \u0639\u064a\u0646\u064a\u0643 \u0645\u0641\u062a\u0648\u062d\u062a\u064a\u0646 \u0648\u0627\u0646\u0638\u0631 \u0625\u0644\u0649 \u0627\u0644\u0643\u0627\u0645\u064a\u0631\u0627\u2026"],"Liveness: blink once slowly\u2026":["\u0627\u0644\u062a\u062d\u0642\u0642 \u0627\u0644\u062d\u064a: \u0627\u0631\u0645\u0634 \u0645\u0631\u0629 \u0648\u0627\u062d\u062f\u0629 \u0628\u0628\u0637\u0621\u2026"],"Liveness: %1$s \u00b7 %2$s \u00b7 eye change %3$s%%":["\u0627\u0644\u062a\u062d\u0642\u0642 \u0627\u0644\u062d\u064a: %1$s \u00b7 %2$s \u00b7 \u062a\u063a\u064a\u0651\u0631 \u0627\u0644\u0639\u064a\u0646 %3$s%%"],"\u2713 blink":["\u2713 \u0631\u0645\u0634"],"blink once":["\u0627\u0631\u0645\u0634 \u0645\u0631\u0629"],"\u2713 movement":["\u2713 \u062d\u0631\u0643\u0629"],"gently move head":["\u062d\u0631\u0651\u0643 \u0631\u0623\u0633\u0643 \u0628\u0647\u062f\u0648\u0621"],"\u2713 Liveness passed.":["\u2713 \u062a\u0645 \u0627\u0644\u062a\u062d\u0642\u0642 \u0627\u0644\u062d\u064a."],"Blink was not detected. Make one clear slow blink while looking at the camera.":["\u0644\u0645 \u064a\u062a\u0645 \u0627\u0643\u062a\u0634\u0627\u0641 \u0631\u0645\u0634. \u0627\u0631\u0645\u0634 \u0645\u0631\u0629 \u0648\u0627\u062d\u062f\u0629 \u0628\u0628\u0637\u0621 \u0648\u0623\u0646\u062a \u062a\u0646\u0638\u0631 \u0625\u0644\u0649 \u0627\u0644\u0643\u0627\u0645\u064a\u0631\u0627."],"Blink detected. Gently move your head left or right and try again.":["\u062a\u0645 \u0627\u0643\u062a\u0634\u0627\u0641 \u0627\u0644\u0631\u0645\u0634. \u062d\u0631\u0651\u0643 \u0631\u0623\u0633\u0643 \u0628\u0647\u062f\u0648\u0621 \u064a\u0645\u064a\u0646\u064b\u0627 \u0623\u0648 \u064a\u0633\u0627\u0631\u064b\u0627 \u062b\u0645 \u062d\u0627\u0648\u0644 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649."],"A face is already enrolled. Verify it or clear the existing enrollment first.":["\u064a\u0648\u062c\u062f \u0648\u062c\u0647 \u0645\u0633\u062c\u0651\u0644 \u0628\u0627\u0644\u0641\u0639\u0644. \u062a\u062d\u0642\u0642 \u0645\u0646\u0647 \u0623\u0648 \u0627\u0637\u0644\u0628 \u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u062a\u0639\u064a\u064a\u0646 \u0623\u0648\u0644\u064b\u0627."],"Enrollment: sample 1 of %d":["\u0627\u0644\u062a\u0633\u062c\u064a\u0644: \u0627\u0644\u0639\u064a\u0646\u0629 1 \u0645\u0646 %d"],"Enrollment: sample %d captured. Slightly change your angle\u2026":["\u0627\u0644\u062a\u0633\u062c\u064a\u0644: \u062a\u0645 \u0627\u0644\u062a\u0642\u0627\u0637 \u0627\u0644\u0639\u064a\u0646\u0629 %d. \u063a\u064a\u0651\u0631 \u0632\u0627\u0648\u064a\u0629 \u0648\u062c\u0647\u0643 \u0642\u0644\u064a\u0644\u064b\u0627\u2026"],"\u2713 Face enrollment saved to Workforce One.":["\u2713 \u062a\u0645 \u062d\u0641\u0638 \u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u0648\u062c\u0647."],"No face is enrolled. Press Enroll Face first.":["\u0644\u0627 \u064a\u0648\u062c\u062f \u0648\u062c\u0647 \u0645\u0633\u062c\u0651\u0644. \u0627\u0636\u063a\u0637 \u00ab\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u0648\u062c\u0647\u00bb \u0623\u0648\u0644\u064b\u0627."],"\u2713 Face verified.":["\u2713 \u062a\u0645 \u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u0644\u0648\u062c\u0647."],"\u2715 Face did not match \u2014 distance %s.":["\u2715 \u0627\u0644\u0648\u062c\u0647 \u063a\u064a\u0631 \u0645\u0637\u0627\u0628\u0642 \u2014 \u0627\u0644\u0645\u0633\u0627\u0641\u0629 %s."],"No face enrollment to reset.":["\u0644\u0627 \u064a\u0648\u062c\u062f \u062a\u0633\u062c\u064a\u0644 \u0648\u062c\u0647 \u0644\u0625\u0639\u0627\u062f\u0629 \u062a\u0639\u064a\u064a\u0646\u0647."],"Request a face reset? Your current enrollment will remain active until an administrator approves the reset.":["\u0647\u0644 \u062a\u0631\u064a\u062f \u0637\u0644\u0628 \u0625\u0639\u0627\u062f\u0629 \u062a\u0639\u064a\u064a\u0646 \u0627\u0644\u0648\u062c\u0647\u061f \u0633\u064a\u0638\u0644 \u062a\u0633\u062c\u064a\u0644\u0643 \u0627\u0644\u062d\u0627\u0644\u064a \u0641\u0639\u0651\u0627\u0644\u064b\u0627 \u062d\u062a\u0649 \u064a\u0648\u0627\u0641\u0642 \u0627\u0644\u0645\u0633\u0624\u0648\u0644 \u0639\u0644\u0649 \u0627\u0644\u0637\u0644\u0628."],"Submitting face reset request\u2026":["\u062c\u0627\u0631\u064d \u0625\u0631\u0633\u0627\u0644 \u0637\u0644\u0628 \u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u062a\u0639\u064a\u064a\u0646\u2026"],"\u2713 Reset request submitted. Your current face enrollment is still active.":["\u2713 \u062a\u0645 \u0625\u0631\u0633\u0627\u0644 \u0637\u0644\u0628 \u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u062a\u0639\u064a\u064a\u0646. \u062a\u0633\u062c\u064a\u0644 \u0648\u062c\u0647\u0643 \u0627\u0644\u062d\u0627\u0644\u064a \u0645\u0627 \u0632\u0627\u0644 \u0641\u0639\u0651\u0627\u0644\u064b\u0627."],"Preparing CSV\u2026":["\u062c\u0627\u0631\u064d \u062a\u062c\u0647\u064a\u0632 \u0645\u0644\u0641 CSV\u2026"],"Could not generate the CSV report.":["\u062a\u0639\u0630\u0651\u0631 \u0625\u0646\u0634\u0627\u0621 \u062a\u0642\u0631\u064a\u0631 CSV."],"Preparing Excel\u2026":["\u062c\u0627\u0631\u064d \u062a\u062c\u0647\u064a\u0632 \u0645\u0644\u0641 Excel\u2026"],"Could not generate the Excel report.":["\u062a\u0639\u0630\u0651\u0631 \u0625\u0646\u0634\u0627\u0621 \u062a\u0642\u0631\u064a\u0631 Excel."]}}}