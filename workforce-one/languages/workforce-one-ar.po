#. Plugin Name of the plugin
#: employee-schedule-manager.php
msgid "Workforce One"
msgstr "Workforce One"

#. Description of the plugin
#: employee-schedule-manager.php
msgid "Workforce management platform for schedules, attendance, reporting and employee operations."
msgstr "منصة لإدارة فرق العمل: الجداول والحضور والتقارير وشؤون الموظفين."

#. Author of the plugin
#: employee-schedule-manager.php
msgid "Internal"
msgstr "داخلي"

#: includes/trait-attendance.php:26
msgid "Attendance tracking is disabled for your employee profile."
msgstr "تسجيل الحضور غير مفعّل في ملفك الوظيفي."

#: includes/trait-attendance.php:33
msgid "Face verification is required before Sign In. Please complete Face Verification and try again."
msgstr "يجب التحقق من الوجه قبل تسجيل الحضور. أكمل التحقق من الوجه ثم حاول مرة أخرى."

#: includes/trait-attendance.php:34
msgid "Your WordPress account is not linked to an active employee."
msgstr "حسابك غير مرتبط بموظف نشط."

#: includes/trait-attendance.php:35
msgid "Today is a General Leave day. Sign In is not required."
msgstr "اليوم إجازة عامة، ولا يلزم تسجيل الحضور."

#: includes/trait-attendance.php:36
msgid "Today is not a working day for you."
msgstr "اليوم ليس يوم عمل بالنسبة لك."

#. translators: %s: start time
#: includes/trait-attendance.php:39
#, php-format
msgid "Sign In is not available yet. Your working hours start at %s."
msgstr "تسجيل الحضور غير متاح بعد. تبدأ ساعات عملك في %s."

#. translators: %s: cutoff time
#: includes/trait-attendance.php:40
#, php-format
msgid "Sign In is no longer available. The Sign In cutoff was %s."
msgstr "انتهى وقت تسجيل الحضور. كان آخر موعد للتسجيل %s."

#: includes/trait-attendance.php:42
msgid "You have already signed in today."
msgstr "لقد سجّلت حضورك اليوم بالفعل."

#: includes/trait-attendance.php:43
msgid "Please Resume Work before signing out."
msgstr "يرجى استئناف العمل قبل تسجيل الانصراف."

#: includes/trait-attendance.php:44
msgid "You cannot sign out before signing in."
msgstr "لا يمكنك تسجيل الانصراف قبل تسجيل الحضور."

#: includes/trait-attendance.php:45
msgid "You have already signed out today."
msgstr "لقد سجّلت انصرافك اليوم بالفعل."

#: includes/trait-attendance.php:78
msgid "This Kiosk location has no coordinates configured. Please contact your administrator."
msgstr "لم يتم ضبط إحداثيات موقع هذا الكشك. يرجى التواصل مع المسؤول."

#: includes/trait-attendance.php:79
msgid "Location access is required for QR Sign In. Please allow Location Services and try again."
msgstr "يلزم الوصول إلى موقعك لتسجيل الحضور عبر QR. اسمح بخدمات الموقع ثم حاول مرة أخرى."

#. translators: 1: work location name, 2: distance
