#, php-format
msgid "You must be at %1$s to use QR Sign In. Distance: %2$s"
msgstr "يجب أن تكون في %1$s لتسجيل الحضور عبر QR. المسافة: %2$s"

#. translators: %s: distance
#: includes/trait-attendance.php:82
#, php-format
