      "<!--EWSQ=\\d+-->",
      ""
    ],
    [
      "(var userSettings = \\{[^}]*\"time\":\")\\d+",
      "\\1T"
    ],
    [
      "\\b\\d+ (?:sec|second|min|minute|hour|day|week|month|year)s? ago\\b",
      "N ago"
    ],
    [
      "((?:min|value)=\")\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d\"",
